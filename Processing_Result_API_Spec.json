{
  "openapi": "3.0.3",
  "info": {
    "title": "Demo AML API - Processing Result Callback",
    "version": "1.5.0",
    "description": "Submit processing result files. Send `processing_job_id` from context plus public `pdf_url` and `xlsx_url`. No authentication required."
  },
  "servers": [
    {
      "url": "https://api-demoaml.atenxion.ai/api",
      "description": "Production Server"
    }
  ],
  "paths": {
    "/processing-jobs/result": {
      "post": {
        "operationId": "submitProcessingResult",
        "tags": ["Processing Jobs"],
        "summary": "Submit processing result",
        "description": "Submit result file URLs after processing completes. Use the exact `processing_job_id` from agent context. Both `pdf_url` and `xlsx_url` must be public http(s) links to the generated files.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitProcessingResultRequest"
              },
              "example": {
                "processing_job_id": "demoaml_event_a84d9c2a-e053-47a1-a07e-e76b9ddd856f",
                "pdf_url": "https://api-qa.atenxion.ai/api/chat-history/get-file-data?filePath=./file_outputs/.../KYC_Report.pdf",
                "xlsx_url": "https://api-qa.atenxion.ai/api/chat-history/get-file-data?filePath=./file_outputs/.../KYC_Appendix.xlsx"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Result stored successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitProcessingResultResponse"
                },
                "example": {
                  "ok": true,
                  "processing_job_id": "demoaml_event_a84d9c2a-e053-47a1-a07e-e76b9ddd856f",
                  "status": "completed",
                  "resultPdfUrl": "https://api-demoaml.atenxion.ai/uploads/USER_ID/results/demoaml_event_a84d9c2a-e053-47a1-a07e-e76b9ddd856f.pdf",
                  "resultXlsxUrl": "https://api-demoaml.atenxion.ai/uploads/USER_ID/results/demoaml_event_a84d9c2a-e053-47a1-a07e-e76b9ddd856f.xlsx"
                }
              }
            }
          },
          "200": {
            "description": "Processing failure recorded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitProcessingFailureResponse"
                },
                "example": {
                  "ok": true,
                  "processing_job_id": "demoaml_event_a84d9c2a-e053-47a1-a07e-e76b9ddd856f",
                  "status": "failed"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request — missing processing_job_id or result URLs",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                },
                "example": {
                  "message": "pdf_url and xlsx_url are required"
                }
              }
            }
          },
          "404": {
            "description": "Processing job not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                },
                "example": {
                  "message": "Processing job not found"
                }
              }
            }
          },
          "409": {
            "description": "Job already completed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                },
                "example": {
                  "message": "Job already completed"
                }
              }
            }
          },
          "502": {
            "description": "Failed to download result files from provided URLs",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                },
                "example": {
                  "message": "Failed to download result files from provided URLs"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                },
                "example": {
                  "message": "Internal server error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorMessage": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "SubmitProcessingResultRequest": {
        "type": "object",
        "required": ["processing_job_id", "pdf_url", "xlsx_url"],
        "properties": {
          "processing_job_id": {
            "type": "string",
            "description": "Exact job id from agent context (same value as event_id)"
          },
          "pdf_url": {
            "type": "string",
            "format": "uri",
            "description": "Public http(s) URL to the generated KYC PDF report"
          },
          "xlsx_url": {
            "type": "string",
            "format": "uri",
            "description": "Public http(s) URL to the generated KYC Excel appendix"
          }
        }
      },
      "SubmitProcessingFailureRequest": {
        "type": "object",
        "required": ["processing_job_id", "status"],
        "properties": {
          "processing_job_id": {
            "type": "string",
            "description": "Exact job id from agent context"
          },
          "status": {
            "type": "string",
            "enum": ["failed"]
          },
          "error": {
            "type": "string",
            "description": "Human-readable failure reason"
          }
        }
      },
      "SubmitProcessingResultResponse": {
        "type": "object",
        "required": ["ok", "processing_job_id", "status"],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "processing_job_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["completed"]
          },
          "resultPdfUrl": {
            "type": "string",
            "format": "uri",
            "description": "Demo AML hosted PDF URL"
          },
          "resultXlsxUrl": {
            "type": "string",
            "format": "uri",
            "description": "Demo AML hosted XLSX URL"
          }
        }
      },
      "SubmitProcessingFailureResponse": {
        "type": "object",
        "required": ["ok", "processing_job_id", "status"],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "processing_job_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["failed"]
          }
        }
      }
    }
  }
}
